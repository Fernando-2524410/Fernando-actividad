<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EvidenciaCESBA"
        android:textSize="28sp"
        android:textColor="@color/azul_claro"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <!-- Fecha automática -->
    <TextView
        android:id="@+id/tvFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/naranja"
        android:layout_marginBottom="20dp"/>

    <!-- Espacio para foto -->
    <ImageView
        android:id="@+id/imgFoto"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@color/texto"
        android:layout_marginBottom="10dp"
        android:contentDescription="Espacio para la fotografía"/>

    <!-- Botón Compartir -->
    <Button
        android:id="@+id/btnCompartir"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="Compartir"
        android:backgroundTint="@color/naranja"
        android:textColor="@color/texto"
        android:textSize="14sp"
        android:layout_marginBottom="15dp"
        android:visibility="gone"/>

    <!-- Botón Tomar foto -->
    <Button
        android:id="@+id/btnTomarFoto"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="TOMAR FOTOGRAFÍA"
        android:backgroundTint="@color/naranja"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginBottom="15dp"/>

    <!-- Campo Título -->
    <EditText
        android:id="@+id/etTitulo"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Escribe el título"
        android:textColorHint="#AAAAAA"
        android:textColor="@color/texto"
        android:inputType="text"
        android:layout_marginBottom="15dp"
        android:backgroundTint="@color/azul_claro"/>

    <!-- Campo Descripción -->
    <EditText
        android:id="@+id/etDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:hint="Describe la evidencia"
        android:textColorHint="#AAAAAA"
        android:textColor="@color/texto"
        android:inputType="textMultiLine"
        android:layout_marginBottom="15dp"
        android:backgroundTint="@color/azul_claro"/>

    <!-- Botón Guardar -->
    <Button
        android:id="@+id/btnGuardar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="GUARDAR EVIDENCIA"
        android:backgroundTint="@color/azul"
        android:textColor="@color/texto"
        android:textSize="18sp"
        android:layout_marginBottom="10dp"/>

    <!-- Botón Ver lista -->
    <Button
        android:id="@+id/btnVerLista"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="VER MIS EVIDENCIAS"
        android:backgroundTint="@color/azul_claro"
        android:textColor="@color/texto"
        android:textSize="16sp"/>

</LinearLayout>